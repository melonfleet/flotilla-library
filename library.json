    {
      "id": "firefly-iii-mariadb",
      "title": "Firefly III + MariaDB",
      "summary": "Production-grade Firefly III setup backed by a dedicated MariaDB relational database.",
      "categories": [
        "Finance & Accounting",
        "Home & Personal"
      ],
      "kind": "stack",
      "tested": {
        "date": "2026-10-13",
        "macs": 1
      },
      "stack": {
        "options": [
          {
            "id": "database",
            "label": "Database Name",
            "defaultValue": "firefly",
            "help": "",
            "email": false
          }
        ],
        "services": [
          {
            "role": "db",
            "title": "MariaDB",
            "image": "docker.io/library/mariadb:13.0.2",
            "env": [
              "MARIADB_DATABASE={{option:database}}",
              "MARIADB_USER=firefly"
            ],
            "secretEnv": [
              {
                "name": "MARIADB_PASSWORD",
                "secret": "db-password"
              },
              {
                "name": "MARIADB_ROOT_PASSWORD",
                "secret": "db-root-password"
              }
            ],
            "volumes": [
              {
                "suffix": "data",
                "path": "/var/lib/mysql"
              }
            ],
            "command": [],
            "wiredPort": 3306,
            "readyPort": 3306
          },
          {
            "role": "app",
            "title": "Firefly III",
            "image": "docker.io/fireflyiii/core:version-6.7.9",
            "env": [
              "DB_HOST={{host:db}}",
              "DB_PORT={{port:db}}",
              "DB_DATABASE={{option:database}}",
              "DB_USERNAME=firefly",
              "DB_CONNECTION=mysql"
            ],
            "secretEnv": [
              {
                "name": "DB_PASSWORD",
                "secret": "db-password"
              },
              {
                "name": "APP_KEY",
                "secret": "app-key"
              }
            ],
            "volumes": [
              {
                "suffix": "data",
                "path": "/var/www/html/storage/upload"
              }
            ],
            "command": [],
            "webPort": 8080
          }
        ],
        "notes": [
          "APP_KEY must be a 32-character string. Database created automatically on start."
        ],
        "opens": "app"
      }
    },
