{
  "categories": [
    "Education",
    "Science & Research"
  ],
  "id": "jupyterhub-postgres",
  "kind": "stack",
  "stack": {
    "notes": [
      "PostgreSQL 18 stores data in /var/lib/postgresql. Mount point modified from legacy /data path."
    ],
    "opens": "hub",
    "options": [
      {
        "defaultValue": "jupyterhub",
        "email": false,
        "help": "",
        "id": "database",
        "label": "Database Name"
      }
    ],
    "services": [
      {
        "command": [],
        "env": [
          "POSTGRES_DB={{option:database}}",
          "POSTGRES_USER=jupyter"
        ],
        "image": "docker.io/library/postgres:18.6",
        "readyPort": 5432,
        "role": "db",
        "secretEnv": [
          {
            "name": "POSTGRES_PASSWORD",
            "secret": "db-password"
          }
        ],
        "title": "PostgreSQL",
        "volumes": [
          {
            "path": "/var/lib/postgresql",
            "suffix": "data"
          }
        ],
        "wiredPort": 5432
      },
      {
        "command": [],
        "env": [
          "POSTGRES_HOST={{host:db}}",
          "POSTGRES_PORT={{port:db}}",
          "POSTGRES_DB={{option:database}}",
          "POSTGRES_USER=jupyter"
        ],
        "image": "quay.io/jupyterhub/jupyterhub:6.1.0",
        "role": "hub",
        "secretEnv": [
          {
            "name": "POSTGRES_PASSWORD",
            "secret": "db-password"
          }
        ],
        "title": "JupyterHub",
        "volumes": [
          {
            "path": "/srv/jupyterhub",
            "suffix": "data"
          }
        ],
        "webPort": 8000
      }
    ]
  },
  "summary": "Multi-user Jupyter notebook server powered by a PostgreSQL state store.",
  "tested": null,
  "title": "JupyterHub + PostgreSQL"
}
