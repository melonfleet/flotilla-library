{
  "categories": [
    "AI & Machine Learning",
    "Software Development"
  ],
  "id": "flowise-postgres",
  "kind": "stack",
  "stack": {
    "notes": [
      "PostgreSQL 18 database path configured to /var/lib/postgresql."
    ],
    "opens": "app",
    "options": [
      {
        "defaultValue": "flowise",
        "email": false,
        "help": "",
        "id": "database",
        "label": "Database Name"
      }
    ],
    "services": [
      {
        "command": [],
        "env": [
          "POSTGRES_DB={{option:database}}",
          "POSTGRES_USER=flowise"
        ],
        "image": "docker.io/library/postgres:18.6",
        "readyPort": 5432,
        "role": "db",
        "secretEnv": [
          {
            "name": "POSTGRES_PASSWORD",
            "secret": "db-password"
          }
        ],
        "title": "PostgreSQL",
        "volumes": [
          {
            "path": "/var/lib/postgresql",
            "suffix": "data"
          }
        ],
        "wiredPort": 5432
      },
      {
        "command": [],
        "env": [
          "DATABASE_TYPE=postgres",
          "DATABASE_HOST={{host:db}}",
          "DATABASE_PORT={{port:db}}",
          "DATABASE_NAME={{option:database}}",
          "DATABASE_USER=flowise"
        ],
        "image": "docker.io/flowiseai/flowise:3.1.4",
        "role": "app",
        "secretEnv": [
          {
            "name": "DATABASE_PASSWORD",
            "secret": "db-password"
          }
        ],
        "title": "Flowise",
        "volumes": [
          {
            "path": "/root/.flowise",
            "suffix": "data"
          }
        ],
        "webPort": 3000
      }
    ]
  },
  "summary": "Production Flowise setup using PostgreSQL for robust workflow state storage.",
  "tested": {
    "date": "2026-10-12",
    "macs": 1
  },
  "title": "Flowise + PostgreSQL"
}
