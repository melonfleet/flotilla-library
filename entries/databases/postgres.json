{
  "categories": [
    "Databases",
    "Software Development"
  ],
  "container": {
    "command": [],
    "env": [
      "POSTGRES_DB=app",
      "POSTGRES_USER=postgres"
    ],
    "image": "docker.io/library/postgres:18.6",
    "name": "postgres",
    "note": "PostgreSQL 18 moved default PGDATA directory root to /var/lib/postgresql. Fresh volume must be writeable by uid 999.",
    "ports": [
      "5432:5432"
    ],
    "secretEnv": [
      "POSTGRES_PASSWORD"
    ],
    "volumes": [
      {
        "path": "/var/lib/postgresql",
        "suffix": "data"
      }
    ]
  },
  "id": "postgres",
  "kind": "container",
  "summary": "Powerful open-source object-relational database system.",
  "tested": {
    "date": "2026-10-13",
    "macs": 1
  },
  "title": "PostgreSQL"
}
