{
  "categories": [
    "Software Development",
    "Communication & Collaboration"
  ],
  "id": "gitea-postgres",
  "kind": "stack",
  "stack": {
    "notes": [
      "PostgreSQL 18 database path updated to /var/lib/postgresql. Complete admin user creation via UI."
    ],
    "opens": "app",
    "options": [
      {
        "defaultValue": "gitea",
        "email": false,
        "help": "",
        "id": "database",
        "label": "Database Name"
      }
    ],
    "services": [
      {
        "command": [],
        "env": [
          "POSTGRES_DB={{option:database}}",
          "POSTGRES_USER=gitea"
        ],
        "image": "docker.io/library/postgres:18.6",
        "readyPort": 5432,
        "role": "db",
        "secretEnv": [
          {
            "name": "POSTGRES_PASSWORD",
            "secret": "db-password"
          }
        ],
        "title": "PostgreSQL",
        "volumes": [
          {
            "path": "/var/lib/postgresql",
            "suffix": "data"
          }
        ],
        "wiredPort": 5432
      },
      {
        "command": [],
        "env": [
          "GITEA__database__DB_TYPE=postgres",
          "GITEA__database__HOST={{host:db}}:{{port:db}}",
          "GITEA__database__NAME={{option:database}}",
          "GITEA__database__USER=gitea"
        ],
        "image": "ghcr.io/go-gitea/gitea:28.1.0",
        "role": "app",
        "secretEnv": [
          {
            "name": "GITEA__database__PASSWD",
            "secret": "db-password"
          }
        ],
        "title": "Gitea",
        "volumes": [
          {
            "path": "/data",
            "suffix": "data"
          }
        ],
        "webPort": 3000
      }
    ]
  },
  "summary": "Production-ready Gitea installation backed by PostgreSQL.",
  "tested": {
    "date": "2026-10-13",
    "macs": 1
  },
  "title": "Gitea + PostgreSQL"
}
